# 数据库
DATABASE_URL="mysql://root:password@localhost:3306/accounting"

# JWT — 生产环境务必使用随机生成的长密钥（≥32字符）
JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-random-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 微信小程序
WECHAT_APPID="your-wechat-appid"
WECHAT_SECRET="your-wechat-secret"

# 短信（可选，注册时需要）
SMS_ACCESS_KEY=""
SMS_SECRET=""

# 服务端口
PORT=3000
NODE_ENV=development
